# Copy to .env on your own server. Never commit real API keys.
# Admin login (required for Docker deployment)
SINTU_AUTH_REQUIRED=true
SINTU_ADMIN_USERNAME=admin
SINTU_ADMIN_PASSWORD=CHANGE-THIS-TO-A-LONG-UNIQUE-PASSWORD
# Generate with: openssl rand -hex 32
SINTU_SESSION_SECRET=CHANGE-THIS-TO-A-RANDOM-64-CHARACTER-SECRET
# false for local HTTP only; true behind HTTPS in production
SINTU_COOKIE_SECURE=false

# Default text provider; can also be selected in Admin > AI Provider Settings
# Choose: auto, openai, gemini
AI_PROVIDER=auto

# OpenAI (API billing is separate from ChatGPT subscription)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.5

# Google AI Studio / Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Same Gemini API key also enables optional Gemini Omni Flash video generation.
# AI video generation uses paid API billing; keep the key server-side.

# Paid image, voice and music generation stays disabled by default.
ENABLE_PAID_MEDIA_GENERATION=false
MEDIA_GENERATION_TOKEN=

# Stability AI Stable Audio 3.0 music generation (paid credits; keep server-side).
STABILITY_API_KEY=
