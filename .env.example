# Copy to .env on your own server. Never commit real API keys.
# Admin login (required for Docker deployment)
SINTU_AUTH_REQUIRED=true
SINTU_ADMIN_USERNAME=admin
SINTU_ADMIN_PASSWORD=CHANGE-THIS-TO-A-LONG-UNIQUE-PASSWORD
# Generate with: openssl rand -hex 32
SINTU_SESSION_SECRET=CHANGE-THIS-TO-A-RANDOM-64-CHARACTER-SECRET
# Docker host bind address: loopback-only by default; use 0.0.0.0 only on a trusted LAN with firewall rules.
SINTU_BIND_ADDRESS=127.0.0.1
# false for local HTTP only; true behind HTTPS in production
SINTU_COOKIE_SECURE=false

# Application firewall: optional comma-separated IP/CIDR allowlist; blank allows all.
# Keep blank for local-only use. Example: SINTU_ALLOWED_IPS=192.0.2.10,192.0.2.0/24
SINTU_ALLOWED_IPS=
# Per-client API request limit per minute (login has a separate stricter limit).
SINTU_RATE_LIMIT_PER_MINUTE=300

# Default text provider; can also be selected in Admin > AI Provider Settings
# Free-first default: local (Ollama) or auto (also resolves to local).
# Paid providers work only when explicitly selected after revenue and approval.
# Choose: local, auto, openai, gemini
AI_PROVIDER=local
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:3b

# Optional free local media engines (no API keys)
PIPER_EXECUTABLE=piper
PIPER_MODEL_PATH=
# Free Hindi fallback TTS; Termux launcher installs espeak automatically.
ESPEAK_EXECUTABLE=espeak
ESPEAK_SPEED=135
COMFYUI_BASE_URL=http://127.0.0.1:8188
COMFYUI_IMAGE_WORKFLOW_PATH=
COMFYUI_VIDEO_WORKFLOW_PATH=
MUSIC_PROVIDER=local
BLENDER_EXECUTABLE=blender

# Paid upgrades are locked until revenue and explicit user approval.
SINTU_REVENUE_CONFIRMED=false
ALLOW_PAID_UPGRADES=false

# OpenAI (API billing is separate from ChatGPT subscription)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.5

# Google AI Studio / Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Same Gemini API key also enables optional Gemini Omni Flash video generation.
# AI video generation uses paid API billing; keep the key server-side.

# Paid image, voice and music generation stays disabled by default.
ENABLE_PAID_MEDIA_GENERATION=false
MEDIA_GENERATION_TOKEN=

# Stability AI Stable Audio 3.0 music generation (paid credits; keep server-side).
STABILITY_API_KEY=

# YouTube Data API v3 + YouTube Analytics API OAuth (enable both APIs in Google Cloud).
# OAuth requests youtube.upload, youtube.readonly and yt-analytics.readonly + yt-analytics-monetary.readonly scopes.
# Add this exact redirect URI to Google Cloud OAuth authorized redirect URIs:
# https://YOUR-DOMAIN/api/admin/youtube/oauth/callback
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REDIRECT_URI=
# Generate once with Python: from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())
# Keep this key stable and backed up; changing it makes saved YouTube tokens unreadable.
YOUTUBE_TOKEN_ENCRYPTION_KEY=

# Meta / Facebook Pages + Instagram Professional account publishing.
# OAuth redirect URI: https://YOUR-DOMAIN/api/admin/meta/oauth/callback
META_APP_ID=
META_APP_SECRET=
META_REDIRECT_URI=
META_GRAPH_API_VERSION=v26.0

# TikTok Login Kit + Content Posting API
# Add Login Kit + Content Posting API; request user.info.basic and video.publish scopes.
# Exact HTTPS callback must be registered in TikTok Developer Portal:
# https://YOUR-DOMAIN/api/admin/tiktok/oauth/callback
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=
